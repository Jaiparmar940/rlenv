# decision-layer kitchen task — HUD managed environment container.
#
# Build context is this directory only (that is what `hud deploy` tarballs), so
# the kitchen_task package must be staged into vendor/ first:
#
#     python deploy/hud/stage.py
#     docker build -f Dockerfile.hud -t decision-layer-kitchen-hud .
#
# Symbolic backend only. No robosuite, no MuJoCo, and none of the ~10 GB of
# RoboCasa kitchen assets are in this image — the sim is the validation
# substrate and ships as evidence (see README.md), not as a runtime dependency.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN pip install uv && uv sync --frozen --no-dev 2>/dev/null || uv sync --no-dev
COPY . .

# Fail the build rather than ship an image that cannot import the task package
# or whose variant set has drifted.
RUN uv run python -c "\
import adapter_core as a; \
assert len(a.TASK_VARIANTS) == 3, a.TASK_VARIANTS; \
s = a.KitchenSession('dlk-01'); \
assert 'TASK: Put the leftovers away' in s.prompt(); \
assert s.backend.name == 'symbolic', s.backend.name; \
print('healthcheck: kitchen_task importable, 3 tasks, symbolic backend')"

# Serve the Environment's control channel (tcp JSON-RPC) on 8765.
EXPOSE 8765
CMD ["uv", "run", "hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]
